{
  "name": "oc",
  "version": "1.0.0",
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read main.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.7.2",
    "hono/jsx": "jsr:@hono/hono@^4.7.2/jsx",
    "hono/cookie": "jsr:@hono/hono@^4.7.2/cookie",
    "hono/html": "jsr:@hono/hono@^4.7.2/html"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  }
}
